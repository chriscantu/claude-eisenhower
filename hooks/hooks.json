{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "npx ts-node ${CLAUDE_PLUGIN_ROOT}/scripts/session-briefing.ts",
          "timeout": 15
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Write|Edit",
      "hooks": [
        {
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/enhance-nudge.sh",
          "timeout": 5,
          "async": true
        }
      ]
    }
  ]
}
